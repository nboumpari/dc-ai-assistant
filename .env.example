# Copy this file to .env and fill in your own values. .env is gitignored.

# OpenAI
OPENAI_API_KEY=
# GPT model used by the agents (a cheaper "mini" model works well for tool calling)
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort: none | low | medium | high
OPENAI_REASONING_EFFORT=low
# Only used when reasoning is none (the API allows a temperature only without reasoning)
OPENAI_TEMPERATURE=0

# LangSmith (tracing and evaluation)
LANGSMITH_API_KEY=
# EU-region accounts must use the EU endpoint; US accounts can remove this line
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=dc-ai-assistant

# Google Gemini, the LLM judge for the rules agent's evaluation (a different model family than the
# agent's OpenAI model). Create a key in Google AI Studio.
GEMINI_API_KEY=

# Hugging Face read token, only needed to download google/embeddinggemma-300m (a gated model:
# accept its licence on huggingface.co first). The other local models download without it.
HF_TOKEN=

# Optional overrides
# WAREHOUSE_DB_PATH=data/generated/warehouse.db
# SQL_MAX_ROWS=200
# SQL_TIMEOUT_SECONDS=10
# Qdrant REST API; docker compose sets http://qdrant:6333 for the app service
# QDRANT_URL=http://localhost:6333
