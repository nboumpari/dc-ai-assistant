# Copy this file to .env and fill in your own values. .env is gitignored.

# OpenAI
OPENAI_API_KEY=
# GPT model used by the data agent (a cheaper "mini" model works well for tool calling)
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort: none | low | medium | high
OPENAI_REASONING_EFFORT=low
# Only used when reasoning is none (the API allows a temperature only without reasoning)
OPENAI_TEMPERATURE=0

# LangSmith (tracing and evaluation)
LANGSMITH_API_KEY=
# EU-region accounts must use the EU endpoint; US accounts can remove this line
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=dc-ai-assistant

# Optional overrides
# WAREHOUSE_DB_PATH=data/generated/warehouse.db
# SQL_MAX_ROWS=200
# SQL_TIMEOUT_SECONDS=10
