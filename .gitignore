# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*
!.env.example

# Generated data (rebuilt by the data generator)
data/generated/

# Downloaded public documents (fetched by script, not committed)
data/documents/raw/
# Extracted text and chunks contain the documents' full text: never commit them either
data/documents/text/
data/documents/chunks/

# Vector index
data/index/

# Saved evaluation runs (the answers quote the documents)
data/eval_runs/
